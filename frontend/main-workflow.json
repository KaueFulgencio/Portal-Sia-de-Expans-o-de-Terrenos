            "name": "Respond to Webhook1"
        },
        {
            "parameters": {
                "jsCode": "const webhookItem = $items('Webhook')[0].json;\n\n// texto normalizado\nconst texto = (webhookItem.body.terrainDescription || '')\n  .toLowerCase()\n  .normalize('NFD')\n  .replace(/[\\u0300-\\u036f]/g, '');\n\n// cidades vindas da planilha (NODE CERTO + COLUNA CERTA)\nconst cidadesSheet = $items('Get row(s) in sheet2').map(item =>\n  item.json.Cidades.trim()\n);\n\n// normaliza cidades da planilha\nconst cidadesNormalizadas = cidadesSheet.map(c =>\n  c.toLowerCase()\n   .normalize('NFD')\n   .replace(/[\\u0300-\\u036f]/g, '')\n);\n\n// detecta cidade\n// detecta cidade prioritária\nlet cidade = null;\nlet cidadePrioritaria = false;\n\nfor (let i = 0; i < cidadesNormalizadas.length; i++) {\n  if (texto.includes(cidadesNormalizadas[i])) {\n    cidade = cidadesSheet[i];\n    cidadePrioritaria = true;\n    break;\n  }\n}\n\n// fallback: tenta pegar cidade \"livre\" do texto\nif (!cidade) {\n  const matchCidade = texto.match(/\\bem\\s+([a-z\\s]+)/i);\n  cidade = matchCidade ? matchCidade[1].trim() : null;\n}\n\n// área\nconst areaMatch = texto.match(/(\\d+)\\s?m2/);\nconst area = areaMatch ? Number(areaMatch[1]) : null;\n\n// valor\nlet valor = null;\n\nconst valorMatch = texto.match(/(\\d+(?:[.,]\\d+)?)\\s?(mil|milhao|milhoes|milh|mi)\\b/);\n\nif (valorMatch) {\n  const numero = Number(valorMatch[1].replace(',', '.'));\n  const unidade = valorMatch[2];\n\n  if (unidade === 'mil') {\n    valor = numero * 1_000;\n  } else {\n    valor = numero * 1_000_000;\n  }\n}\n\n// prioridade\nconst prioridade = cidadePrioritaria ? 'alta' : 'baixa';\n\nreturn [\n  {\n    json: {\n      cidade,\n      area,\n      valor,\n      valorPorM2: area && valor ? Math.round(valor / area) : null,\n      prioridade,\n      inputOriginal: webhookItem.body.terrainDescription\n    }\n  }\n];\n\n"
            },
